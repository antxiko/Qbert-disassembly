# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta. Una entrada sin justificar es una
# direccion metida a mano para que la cobertura cuadre.

# El arranque: la cabecera del cartucho da INIT en 0x405E.
0x405E   # INIT, la direccion que trae la cabecera del cartucho

# INIT escribe un `jp` (0xC3) en 0xFD9A y la direccion 0x4025 en 0xFD9B, que
# es H.KEYI, y se queda en el `jr $` de 0x40C3: todo el juego cuelga de la
# interrupcion, una vez por cuadro.
0x4025   # H.KEYI, enganchado por INIT en 0x4098

# 0x40CE/0x40D3 cargan 0x45FC o 0x441E en HL y 0x40DF lo hace `push hl` antes
# de repartir la escena: el `ret` de la escena salta ahi.
0x45FC   # vuelta de la escena cuando el bit 6 de (0xE002) esta puesto
0x441E   # vuelta de la escena con el bit 6 a cero

# ======================================================================
# LAS TABLAS PEGADAS DETRAS DEL `call` al despachador 0x4054
# ======================================================================
# `pop hl / add a,a / hl += a / ld e,(hl) / inc hl / ld d,(hl) / ex de,hl /
# jp (hl)`: la tabla va pegada detras del `call`. El numero de entradas lo
# mide tools/encaja_tablas.py: la tabla acaba donde empieza su entrada mas baja.
!tabla 0x40e3   9   # desde 0x40E0; cierra en 0x40F5
!tabla 0x6d35  15   # desde 0x6D32; cierra en 0x6D53
!tabla 0x7328   4   # desde 0x7325; cierra en 0x7330
!tabla 0x7628  15   # desde 0x7625; cierra en 0x7646, que es rutina (la llaman con `call`)

# ======================================================================
# CODIGO HUERFANO: el trazado no entra, nadie lo carga con una constante y
# la palabra de su direccion no aparece en los 32 KB (tools/apunta_a.py).
# ======================================================================
0x45FD   # codigo huerfano: intercambia B bytes entre (HL) y (DE)

0x4643   # codigo huerfano: la pareja de 0x4637 para leer la VRAM

0x640D   # codigo huerfano: min(fase - 1, 9), que no llama nadie
0x6757   # codigo huerfano: rellena la tabla de nombres con 0, 1, 2... (visor de patrones)

0x705E   # codigo huerfano: guarda el mando 2, lo mismo que 0x4714 con HL=0xE330
0x7068   # codigo huerfano: las teclas del segundo sin CTRL, copia de 0x4755

0x821A   # codigo huerfano: si a alguno le quedan vidas del duelo; cae en 0x8226
0x8275   # codigo huerfano: vuelve a poner arriba al Q*bert de (0xE332)
0x833C   # codigo huerfano: Z si el otro jugador esta cayendo

0x9032   # codigo huerfano: la prueba del objeto de la vida con el segundo sprite de Q*bert

0x722C   # codigo huerfano: el cubo bajo (E,D) y la comparacion con el modelo
0x77CC   # codigo huerfano: C en catorce objetos seguidos
